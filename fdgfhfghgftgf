printf '%s\n' '===== SailfishOS directories ====='
find "$HOME" -maxdepth 3 -type d \( -iname '*sailfish*' -o -iname '*mersdk*' -o -iname '*build-engine*' \) -print 2>/dev/null

printf '%s\n' '===== recent installer/log files ====='
find "$HOME" /tmp -maxdepth 4 -type f \( -iname '*sdk*log*' -o -iname '*installer*log*' -o -iname '*.log' \) -printf '%TY-%Tm-%Td %TH:%TM %p\n' 2>/dev/null | sort -r | head -80

printf '%s\n' '===== SDK-related directories ====='
find "$HOME/.config" "$HOME/.local/share" "$HOME/.cache" -maxdepth 4 -iname '*sailfish*' -o -iname '*mer*' 2>/dev/null | head -100
