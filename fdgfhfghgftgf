mkdir -p "$HOME/sfos5-metadata"
zipfile=$(find . -maxdepth 1 -type f -iname '*.zip' -print -quit)
echo "ZIP=$zipfile"
sha256sum "$zipfile"
unzip -tqq "$zipfile" && echo "ZIP_INTEGRITY=OK"
unzip -Z1 "$zipfile" > "$HOME/sfos5-metadata/entries.txt"

for entry in \
  META-INF/com/google/android/updater-script \
  META-INF/com/google/android/update-binary \
  sfos-rootfs.tar.bz2 \
  hybris-boot.img \
  setup.sh; do
  echo "===== $entry ====="
  unzip -l "$zipfile" "$entry" 2>/dev/null || true
  unzip -p "$zipfile" "$entry" 2>/dev/null | sed -n '1,220p' || true
  echo
done > "$HOME/sfos5-metadata/report.txt"
cat "$HOME/sfos5-metadata/report.txt"
