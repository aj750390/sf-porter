cd "$HOME/SailfishOS/mersdk" 2>/dev/null || {
  echo "MERSDK_DIRECTORY_NOT_FOUND"
  exit 0
}

printf '%s\n' '===== files ====='
find . -maxdepth 2 -type f -printf '%P\n' | sort | sed -n '1,120p'
printf '%s\n' '===== docker build ====='
docker build --progress=plain \
  --tag sailfish-sdk-build-engine:user \
  . 2>&1 | tee "$HOME/sfdk-docker-build.log"
