

nano ~/sailfish_vayu/vendor/lineage/build/soong/Android.bp

nano ~/sailfish_vayu/build/make/core/board_config.mk


cd ~/sailfish_vayu
git -C vendor/lineage checkout -- build/soong/Android.bp

// LineageOS soong configs

bootstrap_go_package {
    name: "soong-lineage-generator",
    pkgPath: "lineage/soong/generator",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-shared",
    ],
    srcs: [
        "generator/generator.go",
        "generator/variables.go",
    ],
    pluginFor: ["soong_build"],
}

// Define the headers without the broken lineage_generator
cc_library_headers {
    name: "generated_kernel_headers",
    export_include_dirs: [
        "usr/audio/include/uapi",
        "usr/include",
        "usr/include/audio",
        "usr/include/audio/include/uapi",
        "usr/techpack/audio/include",
    ],
    vendor_available: true,
    recovery_available: true,
}

// Target platform agnostic config modules
soong_config_module_type {
    name: "disable_postrender_cleanup",
    module_type: "cc_defaults",
    config_namespace: "lineageGlobalVars",
    bool_variables: ["disable_postrender_cleanup"],
    properties: ["cppflags"],
}

soong_config_module_type {
    name: "surfaceflinger_qcom_ext",
