

nano ~/sailfish_vayu/vendor/lineage/build/soong/Android.bp

nano ~/sailfish_vayu/build/make/core/board_config.mk


cd ~/sailfish_vayu
git -C vendor/lineage checkout -- build/soong/Android.bp

lineage_generator {
    name: "generated_kernel_includes",

    // The headers make command (Halium fix: removed unknown variables)
    cmd: "make headers_install",

    // Directories that can be imported by a cc_* module generated_headers property
    export_include_dirs: [
        "usr/audio/include/uapi",
        "usr/include",
        "usr/include/audio",
        "usr/include/audio/include/uapi",
        "usr/techpack/audio/include",
    ],

    // Sources for dependency tracking (Halium fix: removed unknown variables)
    dep_root: "kernel/xiaomi/sm8150",
    dep_files: [
        "Makefile",
        "include/**/*",
        "arch/arm64/include/**/*",
        "techpack/audio/include/**/*",
    ],
}
